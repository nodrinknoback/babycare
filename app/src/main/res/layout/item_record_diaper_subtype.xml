<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/dp_96"
    android:checkable="true"
    app:cardBackgroundColor="?attr/colorDiaperSubtypeSurface"
    app:cardForegroundColor="@android:color/transparent"
    app:cardCornerRadius="?attr/shapeCornerMedium"
    app:cardElevation="@dimen/dp_0"
    app:checkedIcon="@null"
    app:strokeColor="?attr/colorDiaperSubtypeBorder"
    app:strokeWidth="@dimen/surface_stroke_width">

    <!-- 固定图标占位与双行最小文本高度，让短标签与换行标签共用首行基线。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top|center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/dp_4"
        android:paddingTop="@dimen/dp_8"
        android:paddingEnd="@dimen/dp_4"
        android:paddingBottom="@dimen/dp_8">

        <FrameLayout
            android:id="@+id/iconContainer"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:background="@android:color/transparent">

            <ImageView
                android:id="@+id/ivIcon"
                android:layout_width="@dimen/dp_28"
                android:layout_height="@dimen/dp_28"
                android:layout_gravity="center"
                android:contentDescription="@null"
                app:tint="?attr/colorDiaperSubtypeIcon"
                tools:src="@drawable/ic_record_diaper_wet" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvName"
            style="@style/TextAppearance.BabyCare.Body2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"
            android:gravity="top|center_horizontal"
            android:minLines="2"
            android:textColor="?attr/colorTextPrimary"
            tools:text="小便" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
